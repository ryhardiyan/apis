# Copy to .env (local) or set in Vercel Project Settings > Environment Variables
PORT=3000
PUBLIC_BASE_URL=https://domain.wajib.my.id
CORS_ORIGIN=*
MAX_BODY_SIZE=100kb
RATE_LIMIT_MAX=60
REQUEST_TIMEOUT_MS=15000
DEFAULT_COUNTRY_CODE=62
# Comma-separated plugin names to disable, e.g. tiktok,instagram
DISABLED_PLUGINS=
# Required for /api/instagram/info (format: app_id|app_secret)
INSTAGRAM_APP_TOKEN=
